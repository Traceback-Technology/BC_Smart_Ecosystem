PORT=8000
MONGO_URI=
# generate the token secrete by running the following terminal and paste the results on the TOKEN_SECRET 
#node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
JWT_GUEST_EXPIRES_IN=7d
GUEST_RETENTION_DAYS=7
CLIENT_ORIGIN=
PUBLIC_API_URL=

# Microsoft Entra ID - only these two Microsoft variables are required
MICROSOFT_CLIENT_ID=

# Payments: see STRIPE_SANDBOX.md. `sandbox` only accepts Stripe sandbox keys
# (sk_test_...) and enables the test-card endpoints. Never commit real keys.
PAYMENT_MODE=sandbox
STRIPE_SECRET_KEY=
# Same sandbox as the secret key (pk_test_...). The app fetches it from
# GET /api/payments/config, so it never needs to be built into the app.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/api/payments/webhook`.
# Optional in sandbox mode (use POST /api/payments/:id/sync instead).
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=zar
SERVICE_FEE=5
DRONE_DELIVERY_FEE=15
