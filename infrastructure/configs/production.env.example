# Application

NODE_ENV=production
PORT=5000

# Database

MONGODB_URI=your_production_mongodb_uri

# JWT

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# Socket.IO

SOCKET_PORT=5001

# MQTT

MQTT_BROKER_URL=your_mqtt_broker
MQTT_CLIENT_ID=bc-smart-lifestyle-prod

# Drone

DRONE_SIMULATION_MODE=false

# Frontend URL

CLIENT_URL=https://bcsmartlifestyle.com
